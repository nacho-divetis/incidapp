# Variables de entorno de IncidApp. Copia este archivo a `.env` solo si necesitas cambiar algo:
# en local todo funciona sin `.env` (PGlite, puerto 3000). Nunca subas valores reales al repositorio.

# Entorno: development | test | production
NODE_ENV=development

# Puerto y host de la API (Render define su propio PORT)
PORT=3000
HOST=0.0.0.0

# Conexión a PostgreSQL (Neon). Vacía en local: se usa PGlite.
# Obligatoria en producción; el valor se configura en Render, nunca aquí.
DATABASE_URL=

# Rutas relativas a apps/api (directorio de trabajo de los scripts de la API).
# Carpeta de datos de PGlite en local (ignorada por git)
PGLITE_DATA_DIR=.data/pglite

# Carpeta del build de la web que sirve la API en producción
WEB_DIST_DIR=../web/dist
