{
  "name": "@incidapp/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de IncidApp (Fastify + Clean Architecture). En producción sirve también la web compilada",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && npm run db:seed && tsx watch src/composition/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/composition/db-command.ts migrate",
    "db:seed": "tsx src/composition/db-command.ts seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.12",
    "@incidapp/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
